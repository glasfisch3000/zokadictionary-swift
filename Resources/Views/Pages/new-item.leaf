#extend("standard"):
	#export("standard-head"):
	<script src="/js/edit-item.js"></script>
	#endexport
	
	#export("title"):
	ZokaDictionary - New word
	#endexport
	
	#export("content"):
	<div class="panel success" id="submit-success" hidden>
	Word added
	</div>
	
	<div class="panel">
		<form id="input-form" name="input" method="post">
			<section>
				<label for="string">Word</label>
				<input id="string" type="text" required autofocus name="string" placeholder="Word" title="Word" inputmode="text"/>
				
				<label for="type">Type</label>
				<select id="type" name="type" required>
					<option value="" selected disabled> Select a word type </option>
					<option wordType="adjective" value="adjective"> Adjective </option>
					<option wordType="noun" value="noun"> Noun </option>
					<option wordType="number" value="number"> Number </option>
					<option wordType="particle" value="particle"> Particle </option>
					<option wordType="preposition" value="preposition"> Preposition </option>
					<option wordType="questionWord" value="questionWord"> Question word </option>
					<option wordType="verb" value="verb"> Verb </option>
				</select>
			</section>
			
			<section class="sub-panel" id="translations">
				<div class="sub-panel-title">
					Translations:
					
					<button class="symbol small-button" type="button" onClick="addTranslation()">􀅼</button>
				</div>
			</section>
			
			<section class="sub-panel" id="references">
				<div class="sub-panel-title">
					See also:
					
					<button class="symbol small-button" type="button" onClick="addReference()">􀅼</button>
				</div>
			</section>
			
			<section class="submit-section">
				<div class="error" id="submit-error" hidden></div>
				
				<button id="submit" class="submit-button" type="button" onClick="submitNewItem()"> Submit </button>
				<a class="submit-button cancel" href="#(return)"> Cancel </a>
			</section>
		</form>
	</div>
	#endexport
#endextend
