#extend("standard"):
	#export("standard-head"):
	<link rel="stylesheet" href="/css/delete-item.css">
	#if(success):
	<meta http-equiv="refresh" content="1;url=#(return)"/>
	#endif
	#endexport
	
	#export("title"):
	ZokaDictionary - Delete word permanently
	#endexport
	
	#export("content"):
	#if(success):
	<div class="panel success">
	Word deleted, fr fr on god no cap
	</div>
	#else:
	<div class="panel">
		<form method="post">
			<section class="sub-panel">
				<div id="word-title">
					#(word.value.string)
					
					<span id="word-type" wordType="#(word.value.type)"> (#describeWordType(word.value.type)) </span>
				</div>
				
				#if(count(word.value.translations) > 0):
				<div class="word-other-info">
					Translations:
					
					#for(translation in word.value.translations):
					<span class="word-translation">#(translation.value.translation)</span>
					#endfor
				</div>
				#endif
				
				#if(count(word.value.references) > 0):
				<div class="word-other-info">
					See also:
					
					#for(reference in word.value.references):
					<span class="word-reference">
						#if(reference.value.destination.value.deleted):
						<span class="symbol large-symbol"> 􀈑 </span>
						#endif
						
						#(reference.value.destination.value.string)
					</span>
					#endfor
				</div>
				#endif
				
				#if(count(word.value.backReferences) > 0):
				<div class="word-other-info">
					Referenced by:
					
					#for(reference in word.value.backReferences):
					<span class="word-reference">
						#if(reference.value.source.value.deleted):
						<span class="symbol large-symbol"> 􀈑 </span>
						#endif
						
						#(reference.value.source.value.string)
					</span>
					#endfor
				</div>
				#endif
			</section>
			
			<section id="buttons" class="submit-section">
				<input class="submit-button destructive" type="submit" value="Delete permanently" title="Delete permanently"/>
				<a class="submit-button cancel" href="#(return)"> Cancel </a>
			</section>
		</form>
	</div>
	#endif
	#endexport
#endextend
