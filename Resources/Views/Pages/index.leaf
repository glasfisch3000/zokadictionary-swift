#extend("standard"):
	#export("standard-head"):
	<link rel="stylesheet" href="/css/index.css">
	#endexport
	
	#export("title"):
	ZokaDictionary
	#endexport
	
	#export("content"):
	#if(search):
	<div id="search-info">
		#if(count(words) > 0):
		<div class="symbol"> 􀭥 </div>
		<div> Search: "#(search)" </div>
		#else:
		<div class="symbol"> 􂈂 </div>
		<div class="error"> No search results for "#(search)" </div>
		#endif
		
		<a id="clear-search" class="symbol" href="/"> 􀆄 </a>
	</div>
	#endif
	
	<div id="content">
		#for(word in words):
		<div class="word-card" id="word-#(word.id)">
			<div class="title">
				<a href="/words/#(word.id)">
					#(word.value.string)
					<span class="type" wordType="#(word.value.type)"> (#describeWordType(word.value.type)) </span>
				</a>
				
				#if(user.value.type == "admin" || user.value.type == "contributor"):
				<div class="buttons">
					<a class="small-button symbol" href="/words/#(word.id)/edit?return=#path"> 􂽱 </a>
					<a class="small-button destructive symbol" href="/words/#(word.id)/delete?return=#path"> 􀈑 </a>
				</div>
				#endif
			</div>
			
			#if(count(word.value.translations) > 0):
			<div class="other-info">
				Translations:
				
				#for(translation in word.value.translations):
				<div class="translation">
					<span>
						#(translation.value.translation)
						#if(translation.value.comment):
						<span class="comment"> (#(translation.value.comment)) </span>
						#endif
					</span>
				</div>
				#endfor
			</div>
			#endif
			
			#if(count(word.value.references) > 0):
			<div class="other-info">
				See also:
				
				#for(reference in word.value.references):
				<div class="reference">
					<a href="\#word-#(reference.value.destination.id)">
						<span wordType="#(reference.value.destination.value.type)">
							#(reference.value.destination.value.string)
						</span>
						
						#if(reference.value.comment):
						<span class="comment"> (#(reference.value.comment)) </span>
						#endif
					</a>
				</div>
				#endfor
			</div>
			#endif
		</div>
		#endfor
	</div>
	#endexport
#endextend
