#extend("master"):
	#export("head"):
	<link rel="stylesheet" href="/css/standard.css">
	<link rel="stylesheet" href="/css/dropdown.css">
	<link rel="stylesheet" href="/css/search.css">
	<script src="/js/describe-word-type.js"></script>
	#import("standard-head")
	#endexport
	
	#export("body"):
	<header>
		<div id="backdrop"> </div>
		
		<a id="title" class="header-item" href="/"> ZokaDictionary </a>
		
		<label id="search-button" class="header-item toggle symbol">
			<input id="search-button-input" type="checkbox">
			􀊫
			<div> </div>
		</label>
		
		#if(user.value.type == "admin" || user.value.type == "contributor"):
		<a id="new-word-button" class="header-item symbol" href="/new-item?return=#path"> 􀅼 </a>
		#endif
		
		<label id="login" class="header-item toggle symbol">
			<input type="checkbox">
			<span class="unchecked"> 􀉭 </span>
			<span class="checked"> 􀉮 </span>
			<div> </div>
		</label>
	</header>
	
	<div id="login-dropdown" class="dropdown">
		#if(user):
		<div class="dropdown-item"> #(user.value.name) </div>
		
		<hr/>
		
		#if(user.value.type == "admin"):
		<a class="dropdown-button" href="/users?return=#path">
			<span class="symbol large-symbol"> 􀉫 </span>
			Manage users
		</a>
		
		<hr/>
		#endif
		
		<a class="dropdown-button" href="/change-username?return=#path">
			<span class="symbol"> 􀯩 </span>
			Change username
		</a>
		<a class="dropdown-button" href="/change-password?return=#path">
			<span class="symbol"> 􀎤 </span>
			Change password
		</a>
		<a class="dropdown-button destructive" href="/logout">
			<span class="symbol"> 􁚠 </span>
			Log out
		</a>
		#else:
		<a class="dropdown-button" href="/login">
			<span class="symbol"> 􀰑 </span>
			Log in
		</a>
		#endif
	</div>
	
	<div id="search-container">
		<form id="search-bar" action="/" method="get">
			<input id="search-input" type="text" required autofocus name="search" placeholder="Search words" title="Search" autocomplete="off" inputmode="text"/>
			<input class="symbol" type="submit" value="􀰑" title="Search"/>
		</form>
		
		<div id="search-results"></div>
	</div>
	
	<div id="viewport">
		#import("content")
	</div>
	
	<script src="/js/search.js"></script>
	#endexport
#endextend
